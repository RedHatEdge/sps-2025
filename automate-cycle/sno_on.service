[Unit]
Description=Run sno_on ansible playbook daily in the morning
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=ANSIBLE_CONFIG=/home/admin/Scripts/ansible.cfg
ExecStart=/usr/bin/ansible-playbook -i /home/admin/Scripts/inventory.ini /home/admin/Scripts/sno_on.yaml
RemainAfterExit=false
