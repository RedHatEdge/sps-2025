# This image will be tagged as quay.io/luferrar/sps:ipc-rh10-rt-codesys
FROM quay.io/luferrar/sps:ipc-rh10-rt

# copy rpms to the image
COPY CodeMeter-lite-8.40.7131-502.x86_64.rpm  /tmp/

# install codemeter rpm
RUN dnf -y install /tmp/CodeMeter-lite-8.40.7131-502.x86_64.rpm && \
    dnf clean all

# Lint the build
RUN bootc container lint